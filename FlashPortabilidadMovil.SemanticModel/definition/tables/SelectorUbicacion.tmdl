	measure 'Port In Canal-Ubicacion' = ```
			
			
			
			 var vTipoSeleccionado = 
			        SELECTEDVALUE(SelectorUbicacion[TipoUbicacion])
			
			 var vDiaMinimo = MIN('Días'[Días])
			 var vDiaMaximoSeleccionado = MAX('Días'[Días])
			 var vDiaMaximo = IF(
			                         ISFILTERED('Días'[Días]),vDiaMaximoSeleccionado,DAY(TODAY())-1)
			 VAR vGeneraciondelaSEC =   CALCULATE([Port In Final], 
			                            REMOVEFILTERS('Dim Canal'), TREATAS(VALUES('Dim Canal'[SubCanalID]),'Fact FlashPortabilidad'[SubCanalSECID]),
			                        'Días'[Días]>=vDiaMinimo,
			                       'Días'[Días]<= vDiaMaximo)
			  VAR vOrigenVenta = CALCULATE([Port In Final],
			                       REMOVEFILTERS('Dim Canal'), TREATAS(VALUES('Dim Canal'[SubCanalID]),'Fact FlashPortabilidad'[SubCanalOrigenID]),
			                       'Días'[Días]>=vDiaMinimo,
			                       'Días'[Días]<= vDiaMaximo
			                       )
			   VAR vFinalizacionVenta =  CALCULATE([Port In Final],
			                        REMOVEFILTERS('Dim Canal'), TREATAS(VALUES('Dim Canal'[SubCanalID]),'Fact FlashPortabilidad'[SubCanalActivacionID]),
			                        'Días'[Días]>=vDiaMinimo,
			                       'Días'[Días]<= vDiaMaximo
			                        
			                        )
			     
			
			
			
			return 
			 
			
			    
			    SWITCH(true(),
			        vTipoSeleccionado ="Generacion de la SEC",vGeneraciondelaSEC,
			        vTipoSeleccionado ="Origen de la Venta",vOrigenVenta,
			        vTipoSeleccionado ="Finalización de la Venta",vFinalizacionVenta,
			
			                        
			                         blank()) 
			```
		formatString: #,0
		lineageTag: 699d073d-2905-4981-84d2-b21ce61e544a

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Ventas por Día Dinamico' = ```
			
			
			 var vMesesSeleccionados = VALUES('Dim Calendario'[Mes-Año])
			var vDiaActual = SELECTEDVALUE('Dim Calendario'[Dia])  
			
			var vSemanal = VALUES('Dim Calendario'[SemanaEstandar])
			
			var vPeriodo = SELECTCOLUMNS(ParametroEjeHoja10,ParametroEjeHoja10[ParametroEjeHoja10])
			
			var vSelector = if(not ISFILTERED('Dim Calendario'[Mes-Año]),MAX('Dim Calendario'[Mes-Año]),vMesesSeleccionados)
			
			
			        
			return   
			
			        SWITCH(true(),vPeriodo="Semanal",CALCULATE(
			            [Port-Dinamico],KEEPFILTERS(
			                            FILTER('Dim Calendario','Dim Calendario'[Mes-Año] in vMesesSeleccionados
			                             && 'Dim Calendario'[SemanaEstandar] = vSemanal))),
			                            
			                         vPeriodo="Diarío",
			        CALCULATE(
			            [Port-Dinamico],KEEPFILTERS(
			                            FILTER('Dim Calendario','Dim Calendario'[Mes-Año] in vMesesSeleccionados && 'Dim Calendario'[Dia] = vDiaActual))))
			
			```
		formatString: #,0
		lineageTag: bf4e974c-0862-4201-9c3f-4417af62aa3c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Prueba = CALCULATE([Port In Ubicacion],FILTER(ALL('Dim Calendario'),'Dim Calendario'[Date] >=TODAY()-7*12 && 'Dim Calendario'[Date]<=TODAY()))
		lineageTag: 8911eac4-c050-4f4a-ae07-f6e4426ed435

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variación In' = ```
			
			
			VAR vActual =CALCULATE([Port-Dinamico], 'Indicadores Port'[Indicador] = "Port-In")
			VAR vPasadoSemana = [Port Semana Anterior (Año-Semana)]
			RETURN
			IF(
			    ISBLANK(vPasadoSemana) || vPasadoSemana = 0,
			    BLANK(),
			    DIVIDE(vActual - vPasadoSemana, vPasadoSemana)
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fc5b6ddc-c66d-4156-a0af-1d6bd2077c49

	measure 'Variación Out (Año-Semana)' = ```
			
			VAR vActual =CALCULATE([Port-Dinamico], 'Indicadores Port'[Indicador] = "Port-Out")
			VAR vPasadoSemana = [Port Semana Anterior (Año-Semana)]
			RETURN
			IF(
			    ISBLANK(vPasadoSemana) || vPasadoSemana = 0,
			    BLANK(),
			    DIVIDE(vActual - vPasadoSemana, vPasadoSemana)
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 369ed278-fb6d-41b5-ab92-cdfd780a8e49

	measure 'Variación Out Prueba' = ```
			
			 
			 var vActual = CALCULATE([Ventas por Día Dinamico],'Indicadores Port'[Indicador]="Port-Out")
			
			 var vPasadoSemana = CALCULATE([Ventas por Día Dinamico],DATEADD('Dim Calendario'[Date],-7,DAY),'Indicadores Port'[Indicador]="Port-Out")
			 
			 RETURN
			        if(not ISFILTERED('Dim Calendario'[Mes-Año]),CALCULATE(DIVIDE((vActual-vPasadoSemana),vPasadoSemana),'Dim Calendario'[Índice]=MAX('Dim Calendario'[Índice]))
			        ,DIVIDE((vActual-vPasadoSemana),vPasadoSemana))
			```
		lineageTag: db4b8c27-c71a-4114-93bb-3704ce8eec3b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Port Semana Anterior (Año-Semana)' = ```
			
			VAR vCurYear = SELECTEDVALUE('Dim Calendario'[Año])
			VAR vCurWeek = SELECTEDVALUE('Dim Calendario'[SemanaAño])  // usa la columna que corresponda
			// Si no hay contexto (por ejemplo en card), toma MAX en visual
			VAR vCurYearSafe = IF(ISBLANK(vCurYear), MAX('Dim Calendario'[Año]), vCurYear)
			VAR vCurWeekSafe = IF(ISBLANK(vCurWeek), MAX('Dim Calendario'[SemanaAño]), vCurWeek)
			
			// Determinar semana anterior y año anterior (considera 52/53 semanas)
			VAR vPrevYear =
			    IF(vCurWeekSafe = 1, vCurYearSafe - 1, vCurYearSafe)
			VAR // detectar si año anterior tiene 53 semanas
			    vMaxWeekPrevYear =
			        CALCULATE(
			            MAX('Dim Calendario'[SemanaAño]),
			            ALL('Dim Calendario'),
			            'Dim Calendario'[Año] = vCurYearSafe - 1
			        )
			VAR vPrevWeek =
			    IF(
			        vCurWeekSafe = 1,
			        IF(vMaxWeekPrevYear = 53, 53, 52),
			        vCurWeekSafe - 1
			    )
			
			RETURN
			CALCULATE(
			    [Port-Dinamico],
			    FILTER(
			        ALL('Dim Calendario'),
			        'Dim Calendario'[Año] = vPrevYear &&
			        'Dim Calendario'[SemanaAño] = vPrevWeek
			    )
			)
			
			```
		formatString: 0
		lineageTag: 906295a2-c85c-4439-9bb0-7dae6fe1ec89

	measure 'Port-In Mes Actual rEFACT' = ```
			
			 
			 var vHayFiltro = ISFILTERED('Dim Calendario'[Mes-Año])
			 var vInicio = TODAY()-7*12
			 var vFin = TODAY()
			 RETURN
			
			 if(vHayFiltro,CALCULATE([Port In Ubicacion],'Dim Calendario'[Mes-Año]=SELECTEDVALUE('Dim Calendario'[Mes-Año])),CALCULATE([Port In Ubicacion],FILTER(ALL('Dim Calendario'),'Dim Calendario'[Date] > vInicio && 'Dim Calendario'[Date]<=vFin)))
			
			
			
			```
		lineageTag: 8f2c643b-0b5a-400d-886f-82c2e5b0ffc6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Port In Ubicacion RLS' =
			
			VAR vTipo =
			    SELECTEDVALUE ( SelectorUbicacion[TipoUbicacion] )
			
			VAR vDeptosVisibles =
			    VALUES ( 'Dim Ubicacion'[DepartamentoID] )
			
			VAR vDiaMin =
			    MIN ( 'Dim Calendario'[Dia] )
			
			VAR vDiaMaxSel =
			    MAX ( 'Dim Calendario'[Dia] )
			
			VAR vDiaMax =
			    IF (
			        ISFILTERED ( 'Dim Calendario'[Dia] ),
			        vDiaMaxSel,
			        DAY ( TODAY () ) - 1
			    )
			
			-------------------------------------------------------------
			-- GENERACIÓN SEC → DepartamentoSECID
			-------------------------------------------------------------
			VAR vSEC =
			    CALCULATE (
			        [Port In Final],
			        KEEPFILTERS (
			            'Fact FlashPortabilidad'[DepartamentoSECID] IN vDeptosVisibles
			        ),
			        'Dim Calendario'[Dia] = vDiaMax
			    )
			
			-------------------------------------------------------------
			-- ORIGEN → DepartamentoOrigenID
			-------------------------------------------------------------
			VAR vOrigen =
			    CALCULATE (
			        [Port In Final],
			        KEEPFILTERS (
			            'Fact FlashPortabilidad'[DepartamentoOrigenID] IN vDeptosVisibles
			        ),
			        'Dim Calendario'[Dia] >= vDiaMin,
			        'Dim Calendario'[Dia] <= vDiaMax
			    )
			
			-------------------------------------------------------------
			-- FINALIZACIÓN → DepartamentoFinalizacionID
			-------------------------------------------------------------
			VAR vFinalizacion =
			    CALCULATE (
			        [Port In Final],
			        KEEPFILTERS (
			            'Fact FlashPortabilidad'[DepartamentoFinalizacionID] IN vDeptosVisibles
			        ),
			        'Dim Calendario'[Dia] >= vDiaMin,
			        'Dim Calendario'[Dia] <= vDiaMax
			    )
			
			RETURN
			SWITCH (
			    TRUE(),
			    vTipo = "Generacion de la SEC", vSEC,
			    vTipo = "Origen de la Venta", vOrigen,
			    vTipo = "Finalizacion de la Venta", vFinalizacion,
			    BLANK()
			)
		formatString: #,0
		lineageTag: d7efeb2c-a776-4e35-8f8b-b1997e573354

