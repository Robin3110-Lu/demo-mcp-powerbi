	measure Color =
			
			var periodo_max = CALCULATE(MAX('Fecha Anterior'[Mes Año]), DATESMTD('Fecha Anterior'[Fecha]))
			RETURN SWITCH(SELECTEDVALUE(Alterno[Año]),
			            periodo_max, "#CFFDAF",
			            "Mes Actual", "#CFFDAF",
			            "MoM%", "#E2F0FB",
			            "YoY%", "#E2F0FB",
			            "YTD%", "#E2F0FB"
			        )
