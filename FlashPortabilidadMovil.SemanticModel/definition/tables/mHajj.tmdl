	measure 'Mostrar Medida Hajj Final Basica' = ```
			
			var vMesEscogido= SELECTEDVALUE('Dim Calendario'[Mes-Año])
			var vSelectorVista = SELECTEDVALUE(Vista[Descripcion])
			
