	measure 'PortNeto Mes Año Anterior' = ```
			
			
			 var vMesAnoSel = SELECTEDVALUE('Dim Calendario'[Mes-Año])
			 var vMesSel = CALCULATE(max('Dim Calendario'[Mes Numero]),'Dim Calendario'[Mes-Año]=vMesAnoSel)
			 var vAnoSel = CALCULATE(MAX('Dim Calendario'[Año]),'Dim Calendario'[Mes-Año]=vMesAnoSel)
			 RETURN
			 CALCULATE([Port Neto Ubicacion],
			                FILTER(all('Dim Calendario'),
			                        'Dim Calendario'[Mes Numero] = vMesSel &&
			                         'Dim Calendario'[Año]= vAnoSel-1))
			```
		lineageTag: 5257a9a2-ebed-4e8a-842a-17f428757e55

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Port-Neto' = [Port Neto Ubicacion]-[PortNeto Mes Año Anterior]
