table mVariaciones
	lineageTag: f8c1c776-7541-4433-96b7-3d1a1728e5a1

	measure MesAnteriorPorIn = ```
			
			var vFechaMaxSel = MAX('Dim Calendario'[Date])
			var vFechaInicioMesAnterior = 
			        EOMONTH(vFechaMaxSel,-2)+1
			var vFechaFinMesAnterior = 
			        EOMONTH(vFechaMaxSel,-1)
			return
			
			        CALCULATE(
			            [Port-In Mes Actual],
			            'Dim Calendario'[Date]>=vFechaInicioMesAnterior,
			            'Dim Calendario'[Date]<=vFechaFinMesAnterior
			        )
			```
		formatString: #,0
		lineageTag: f71fbd7c-7568-4a2a-89ce-462adcd23ac0

	measure MesAnteriorPorOut = ```
			
			var vFechaMaxSel = MAX('Dim Calendario'[Date])
			var vFechaInicioMesAnterior = 
			        EOMONTH(vFechaMaxSel,-2)+1
			var vFechaFinMesAnterior = 
			        EOMONTH(vFechaMaxSel,-1)
			return
			
			        CALCULATE(
			            [Port-Out Mes Actual],
			            'Dim Calendario'[Date]>=vFechaInicioMesAnterior,
			            'Dim Calendario'[Date]<=vFechaFinMesAnterior
			        )
			```
		formatString: #,0
		lineageTag: e7f88586-8eee-496c-bdc0-5df4dc7a12bf

		annotation PBI_FormatHint = {"isDecimal":true}

	measure MesAnteriorPortNeto = ```
