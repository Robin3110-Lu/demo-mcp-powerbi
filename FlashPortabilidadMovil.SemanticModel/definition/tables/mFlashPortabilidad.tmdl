	measure 'Port-Neto Vista Normal' = ```
			
			
			
			
			VAR vCompleto = CALCULATE([Port Neto Normal],'Dim Calendario'[Mes Completo] = TRUE())
			VAR vMinDia = MIN('Días'[Días])
			VAR vMaxDia = MAX('Días'[Días])
			VAR vParcial = CALCULATE([Port Neto Normal],
			'Dim Calendario'[Dia]>= vMinDia,
			'Dim Calendario'[Dia]<= vMaxDia)
			VAR vTotal =[Port Neto Normal]
			VAR vParcialBlank = CALCULATE([Port Neto Normal],'Dim Calendario'[Día Corte] = TRUE())
			RETURN
			
			IF(NOT(ISFILTERED('Días'[Días])),
			
			IF(
			    HASONEVALUE(Vista[Descripcion]),
			    IF(SELECTEDVALUE(Vista[Descripcion]) = "Completo",vCompleto,
			     IF(SELECTEDVALUE(Vista[Descripcion])= "Parcial", vParcialBlank,vTotal)),0),
			IF(HASONEVALUE(Vista[Descripcion]),
			    IF(SELECTEDVALUE(Vista[Descripcion]) = "Completo",vCompleto,
			     IF(SELECTEDVALUE(Vista[Descripcion])= "Parcial", vParcial,vTotal)),0))
			
			```
		displayFolder: PortNeto
		lineageTag: eb8ad03c-cc62-45f9-a244-4d71fcf2e86a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

