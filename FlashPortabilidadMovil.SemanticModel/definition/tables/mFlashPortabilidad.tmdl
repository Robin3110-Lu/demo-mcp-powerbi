	measure '%Port In Ubicacion' =
			
			
			DIVIDE(
			        [Port In Ubicacion],
			        CALCULATE([Port In Ubicacion],
			        REMOVEFILTERS('Dim Operador'),REMOVEFILTERS('Dim Segmento'[FormaContratación]),REMOVEFILTERS('Dim Ubicacion'[Region]),REMOVEFILTERS('Dim Canal'[MacroCanal])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1febcf5d-9698-4cc1-a709-6bdcdaaee879

	measure 'Port Out Final Negativo' = ```
			
			
			 SWITCH(
			
			    [Tipo Seleccionado],
			    "Normal",[Port-Out Vista Normal]*-1,
			    "Real",[Port-Out Vista Real]*-1)
			```
		displayFolder: PortOut
		lineageTag: d45f5a1b-83f5-483f-8502-398ff26b8e5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Departamentos Pierde' = ```
			
			
			var vDepartamentosConPerdida =
			ADDCOLUMNS( VALUES('Dim Ubicacion'[Departamento]),
			                "@Movistar",CALCULATE([Port Neto Ubicacion],'Dim Operador'[Operador]="Movistar"),
			                "@Bitel",CALCULATE([Port Neto Ubicacion],'Dim Operador'[Operador]="Bitel"),
			                "@Entel",CALCULATE([Port Neto Ubicacion],'Dim Operador'[Operador]="Entel"))
			
			RETURN
			            COUNTROWS(FILTER(vDepartamentosConPerdida,[@Movistar]<0 || [@Bitel]<0  || [@Entel]<0 ))
			
			```
		formatString: 0
		lineageTag: 8f7f834c-e11b-44f7-b0cc-52d52a71fa31

	measure 'Bitel Departamentos Pierde' =
			
			
			COUNTROWS(FILTER(VALUES('Dim Ubicacion'[Departamento]),calculate([Port Neto Ubicacion],'Dim Operador'[Operador]="Bitel")<0))
		formatString: 0
		lineageTag: 24d5ba55-0886-4581-8a00-3c9a0dace1d4

	measure 'Entel Departamentos Pierde' =
			
			
