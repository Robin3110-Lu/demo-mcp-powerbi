			VAR vParcial = CALCULATE([Port In],
			'Dim Calendario'[Dia]>= vMinDia,
			'Dim Calendario'[Dia]<= vMaxDia)
			VAR vTotal =[Port In]
			VAR vParcialBlank = CALCULATE([Port In],'Dim Calendario'[Día Corte] = TRUE())
			RETURN
			
			IF(NOT(ISFILTERED('Días'[Días])),
			
			IF(
			    HASONEVALUE(Vista[Descripcion]),
			    IF(SELECTEDVALUE(Vista[Descripcion]) = "Completo",vCompleto,
			     IF(SELECTEDVALUE(Vista[Descripcion])= "Parcial", vParcialBlank,vTotal)),0),
			IF(HASONEVALUE(Vista[Descripcion]),
			    IF(SELECTEDVALUE(Vista[Descripcion]) = "Completo",vCompleto,
			     IF(SELECTEDVALUE(Vista[Descripcion])= "Parcial", vParcial,vTotal)),0))
		displayFolder: PortIn
		lineageTag: 9a686ff1-3b54-40c6-a209-f816af773ab4

