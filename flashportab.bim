      {
        "name": "Dim Calendario",
        "lineageTag": "053c3a99-3c6f-45ad-b326-8bba713651e9",
        "dataCategory": "Time",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isKey": true,
            "sourceColumn": "[Date]",
            "formatString": "General Date",
            "lineageTag": "f758e110-13ed-4068-bdd5-9bebc14c21cc",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Año",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "YEAR('Dim Calendario'[Date])",
            "formatString": "0",
            "lineageTag": "f9515b14-9f2a-411e-a337-b743ecb759df",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "MesNombre",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "var mes_ =FORMAT('Dim Calendario'[Date],\"mmmm\")",
              "RETURN REPLACE(mes_, 1, 1, UPPER(LEFT(LEFT(mes_))))"
            ],
            "lineageTag": "72f78588-47dd-4673-b51f-4555222d3579",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Mes",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "        VAR _X = FORMAT('Dim Calendario'[Date],\"mmmm\")",
              "        VAR _Y = UPPER(LEFT(_X))",
              "        VAR _Z = MID(_X,2,2)",
              "",
              "",
              "        RETURN",
              "        _Y&_Z"
            ],
            "lineageTag": "a4d8a694-e18f-4b90-9e4f-63d5e3a9800f",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Mes-Año",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "var periodo_ = FORMAT('Dim Calendario'[Date], \"mmm-yyyy\")",
              "return REPLACE(periodo_, 1, 1, UPPER(LEFT(LEFT(periodo_))))"
            ],
            "sortByColumn": "Año Mes Índice",
            "lineageTag": "4643069e-53f7-463b-8401-58484b7dfb79",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Año Mes",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "CONVERT(FORMAT('Dim Calendario'[Date], \"yyyymm\"), INTEGER)",
            "formatString": "0",
            "lineageTag": "401e5ff0-dcaf-4d40-bd97-14c0729550af",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Mes Numero",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "MONTH('Dim Calendario'[Date])",
            "formatString": "0",
            "lineageTag": "fdd43b3d-98e0-4212-8afe-bacf957d9e12",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Dia",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "DAY('Dim Calendario'[Date])",
            "formatString": "0",
            "lineageTag": "349fc7fc-c99c-48d1-ad5e-f567c8af0ec7",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Mes Corto",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH('Dim Calendario'[Mes Numero],",
              "        1,\"Ene\",",
              "        2,\"Feb\",",
              "        3,\"Mar\",",
              "        4,\"Abr\",",
              "        5,\"May\",",
              "        6,\"Jun\",",
              "        7,\"Jul\",",
              "        8,\"Ago\",",
              "        9,\"Sep\",",
              "        10,\"Oct\",",
              "        11,\"Nov\",",
              "        12,\"Dic\"",
              ")"
            ],
            "lineageTag": "fb645c85-fd4f-448d-9641-5aded3e7314d",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Periodo",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('Dim Calendario'[Date],\"YYYYMM\")",
            "lineageTag": "8a0544d0-4891-4806-a31c-0f8290509979",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Orden Mes Año",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('Dim Calendario'[Date],\"YYMM\")",
            "lineageTag": "a5e8789c-73db-4b22-8ec9-a97bef2798b2",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Año Mes Índice",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "'Dim Calendario'[Año]&\"-\"&FORMAT(MONTH('Dim Calendario'[Date]),\"00\")",
            "lineageTag": "5efc194b-c87c-4488-8194-20fdbf392152",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Índice",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "COUNTROWS(",
              "                FILTER(VALUES('Dim Calendario'[Año Mes Índice]),",
              "                       'Dim Calendario'[Año Mes Índice]<EARLIER('Dim Calendario'[Año Mes Índice])",
              "))--+1"
            ],
            "formatString": "0",
            "lineageTag": "14c710f5-f606-4e15-821a-94e9a55e18e4",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Mes Completo",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "    VAR vMaxMes = MAX('Dim Calendario'[Date])",
              "    VAR vEsteMesID =",
              "        LOOKUPVALUE('Dim Calendario'[Índice],'Dim Calendario'[Date],vMaxMes)",
              "    RETURN 'Dim Calendario'[Índice] < vEsteMesID     "
            ],
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "beae3042-c5c6-483f-a9c1-3ac65322cde1",
