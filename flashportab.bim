            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),",
                "    #\"Tipo cambiado\" = Table.TransformColumnTypes(Origen,{{\"Columna1\", type text}}),",
                "    #\"Columnas quitadas\" = Table.RemoveColumns(#\"Tipo cambiado\",{\"Columna1\"})",
                "in",
                "    #\"Columnas quitadas\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "MesAnteriorPorIn",
            "expression": [
              "",
              "var vFechaMaxSel = MAX('Dim Calendario'[Date])",
              "var vFechaInicioMesAnterior = ",
              "        EOMONTH(vFechaMaxSel,-2)+1",
              "var vFechaFinMesAnterior = ",
              "        EOMONTH(vFechaMaxSel,-1)",
              "return",
              "",
              "        CALCULATE(",
              "            [Port-In Mes Actual],",
              "            'Dim Calendario'[Date]>=vFechaInicioMesAnterior,",
              "            'Dim Calendario'[Date]<=vFechaFinMesAnterior",
              "        )"
            ],
            "formatString": "#,0",
            "lineageTag": "f71fbd7c-7568-4a2a-89ce-462adcd23ac0"
          },
          {
            "name": "MesAnteriorPorOut",
            "expression": [
              "",
              "var vFechaMaxSel = MAX('Dim Calendario'[Date])",
              "var vFechaInicioMesAnterior = ",
              "        EOMONTH(vFechaMaxSel,-2)+1",
              "var vFechaFinMesAnterior = ",
              "        EOMONTH(vFechaMaxSel,-1)",
              "return",
              "",
              "        CALCULATE(",
              "            [Port-Out Mes Actual],",
              "            'Dim Calendario'[Date]>=vFechaInicioMesAnterior,",
              "            'Dim Calendario'[Date]<=vFechaFinMesAnterior",
              "        )"
            ],
            "formatString": "#,0",
            "lineageTag": "e7f88586-8eee-496c-bdc0-5df4dc7a12bf",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "MesAnteriorPortNeto",
            "expression": "[MesAnteriorPorIn]-[MesAnteriorPorOut] ",
            "formatString": "#,0",
            "lineageTag": "3759884e-387a-4275-91fd-dffa83aca534"
          },
          {
            "name": "MoM Port-In",
            "expression": "[Port-In Mes Actual]-[MesAnteriorPorIn] ",
            "formatString": "#,0",
            "lineageTag": "f6a0e52c-9f5b-4192-ba42-dac14cd00b64"
          },
          {
            "name": "%MoM Port-In",
            "expression": [
              "",
              "if(not ISBLANK([MesAnteriorPorIn]),",
              "DIVIDE([Port-In Mes Actual]-[MesAnteriorPorIn],[MesAnteriorPorIn])) "
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "5a6db2c1-e70a-444a-a696-2fc4175c802f"
          },
          {
            "name": "MoM Port-Out",
            "expression": "[Port-Out Mes Actual]-[MesAnteriorPorOut] ",
            "formatString": "#,0",
            "lineageTag": "4725c6e7-7f0d-40ad-a133-61313c9db448"
          },
          {
            "name": "%MoM Port-Out",
            "expression": [
              "",
              "if(not ISBLANK([MesAnteriorPorOut]),",
              "DIVIDE([Port-Out Mes Actual]-[MesAnteriorPorOut],[MesAnteriorPorOut])) "
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "c7790607-4484-4cd7-863b-2c9fedf48e9f"
          },
          {
            "name": "MoM Port-Neto",
            "expression": "[Port-Neto Mes Actual]-[MesAnteriorPortNeto] ",
            "formatString": "#,0",
            "lineageTag": "159e6c08-22e1-461c-bebb-cdd7e7c782a4"
          },
          {
            "name": "%MoM Port-Neto",
            "expression": [
              "",
