            "expression": [
              "",
              "    VAR _MaxMes = MAX('Dim Calendario'[Date])",
              "    VAR _EsteMesID =",
              "        LOOKUPVALUE('Dim Calendario'[Índice],'Dim Calendario'[Date],_MaxMes)",
              "    RETURN IF( 'Dim Calendario'[Índice] < _EsteMesID ,0 ,'Dim Calendario'[Dia])    "
            ],
