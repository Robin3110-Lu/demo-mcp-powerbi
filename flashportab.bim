              "type": "calculated",
              "expression": [
                "DATATABLE(\"TipoUbicacion\",STRING,",
                "    \"Orden\",INTEGER,",
                "{",
                "    {\"Generacion de la SEC\",1},",
                "    {\"Origen de la Venta\",2},",
