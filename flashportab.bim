            ],
            "lineageTag": "99bfaa17-81da-411a-8551-9941b3f0a0e6"
          },
          {
            "name": "Mostrar Medida Formateado Hoja 8",
            "expression": [
              "",
              "VAR vAnio_evaluacion = SELECTEDVALUE(Alterno[Año])",
              "VAR vFormato = SELECTEDVALUE('Selector Real/Normal'[TipoDato])",
              "VAR vIndicador = SELECTEDVALUE(Alterno[Indicador])",
              "var vMesAnio = SELECTEDVALUE(Alterno[Mes Año])",
              "",
              "",
              "VAR vTotal           = [20. Ventas por Periodo]",
              "VAR vMesActual       = [27. Ventas Mes Actual]",
              "VAR vMesAnioAnterior = [29. Ventas Mes Año Anterior]",
              "VAR vMoM             = [28. Dif. Ventas Mes Actual]",
              "VAR vMoM_P           = [31. %Var Ventas MA]",
              "VAR vYoY             = [30. Dif. Ventas SPLY]",
              "VAR vYoY_P           = [32. %Var Ventas SPLY]",
              "VAR vYTDActual       = [23. Ventas YTD]",
              "VAR vYTD_SPLY        = [24. Ventas YTD SPLY] ",
              "VAR vYTD_            = [25. Dif. Ventas YTD]",
              "VAR vYTD_P           = [26. %Var Ventas YTD]",
              "",
              "",
              "-- Elegimos el valor a mostrar",
              "VAR vValor =",
              "    SWITCH(",
              "        TRUE(),",
              "        vIndicador = 1, vTotal,",
              "        vAnio_evaluacion = \"Mes Actual\" && vMesAnio = [Mes Etiqueta Actual], vMesActual,",
              "        vAnio_evaluacion = \"Mes Anio Anterior\" && vMesAnio = [Mes Etiqueta Actual (Y-1)], vMesAnioAnterior,",
              "        vAnio_evaluacion = \"MoM\", vMoM,",
              "        vAnio_evaluacion = \"MoM%\", vMoM_P,",
              "        vAnio_evaluacion = \"YoY\", vYoY,",
              "        vAnio_evaluacion = \"YoY%\", vYoY_P,",
              "        vAnio_evaluacion = [Anio Pasado], vYTD_SPLY,",
              "        vAnio_evaluacion = [Anio Actual], vYTDActual,",
              "        vAnio_evaluacion = \"YTD\", vYTD_,",
              "        vAnio_evaluacion = \"YTD%\", vYTD_P",
              "    )",
              "",
              "",
              "",
              "VAR Formatear =",
              "    SWITCH(",
              "        TRUE(),",
              "        vFormato = \"Porcentaje\", FORMAT(vValor, \"0.0%\", \"es-PE\"),",
              "        vFormato = \"Tiempo\",",
              "            VAR h = INT(vValor/ 60)",
              "            VAR m = MOD(vValor, 60)",
              "            RETURN FORMAT(h, \"00\") & \":\" & FORMAT(m, \"00\"),",
              "        FORMAT(vValor, \"0\", \"es-PE\")",
              "    )",
              "",
              "VAR FormatearConSoles =",
              "    SWITCH(",
              "        TRUE(),",
              "        vFormato = \"Porcentaje\", FORMAT(vValor, \"0.0%\", \"es-PE\"),",
              "        vFormato = \"Tiempo\",",
              "            VAR h = INT(vValor / 60)",
              "            VAR m = MOD(vValor, 60)",
              "            RETURN FORMAT(h, \"00\") & \":\" & FORMAT(m, \"00\"),",
              "        ABS(vValor) > 1000000,  FORMAT(vValor, \"#,,.0M\", \"es-PE\"),",
              "        ABS(vValor) > 1000,  FORMAT(vValor, \"#,##0,.00K\", \"es-PE\"),",
              "         FORMAT(vValor, \"0\", \"es-PE\")",
              "    )",
              "",
              "",
              "RETURN",
              "IF(",
              "    SELECTEDVALUE(Alterno[Indicador]) = 1,",
              "    IF(NOT(ISBLANK(vTotal)),",
              "        SUBSTITUTE(FormatearConSoles, \"_\", vTotal)",
              "    ),",
              "    SWITCH(",
              "        vAnio_evaluacion,",
              "",
              "        \"Mes Actual\",",
              "            SWITCH(",
              "                SELECTEDVALUE(Alterno[Mes Año]), [Mes Etiqueta Actual],",
              "                IF(NOT(ISBLANK(vMesActual)), SUBSTITUTE(FormatearConSoles, \"_\", vMesActual), BLANK())",
              "            ),",
              "",
              "        \"Mes Anio Anterior\",",
              "            SWITCH(",
              "                SELECTEDVALUE(Alterno[Mes Año]), [Mes Etiqueta Actual (Y-1)],",
              "                IF(NOT(ISBLANK(vMesAnioAnterior)), SUBSTITUTE(FormatearConSoles, \"_\", vMesAnioAnterior), BLANK())",
              "            ),",
              "",
              "        \"MoM\",",
              "            IF(NOT(ISBLANK(vMoM)), SUBSTITUTE(FormatearConSoles, \"_\", vMoM)),",
              "",
              "        \"MoM%\",",
              "             IF(NOT(ISBLANK(vMoM_P)),FORMAT(vMoM_P, \"0.0%\",\"es-PE\")),",
              "",
              "        \"YoY\",",
              "            IF(NOT(ISBLANK(vYoY)), SUBSTITUTE(FormatearConSoles, \"_\", vYoY)),",
              "",
              "        \"YoY%\",",
              "          IF(NOT(ISBLANK(vYoY_P)),FORMAT(vYoY_P, \"0.0%\",\"es-PE\")),",
              "",
              "        [Anio Pasado],",
              "            IF(NOT(ISBLANK(vYTD_SPLY)), SUBSTITUTE(FormatearConSoles, \"_\", vYTD_SPLY)),",
              "",
              "        [Anio Actual],",
              "            IF(NOT(ISBLANK(vYTDActual)), SUBSTITUTE(FormatearConSoles, \"_\", vYTDActual)),",
              "",
              "        \"YTD\",",
              "            IF(vFormato = \"Porcentaje\", FORMAT(vValor, \"0.0%\", \"es-PE\"),",
              "            IF(NOT(ISBLANK(vYTD_)), ",
              "                        IF(ABS(vYTD_)>1000000, FORMAT(vYTD_, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vYTD_)>1000, FORMAT(vYTD_,\"#,##0,.00K\",\"es-PE\"), FORMAT(vYTD_, \"0\",\"es-PE\"))))  ),",
              "",
              "        \"YTD%\",",
              "           IF(NOT(ISBLANK(vYTD_P)),FORMAT(vYTD_P, \"0.0%\",\"es-PE\"))",
              "    )",
              ")",
              ""
            ],
            "lineageTag": "8023566d-0365-4350-a12d-6b193416ac89"
          },
