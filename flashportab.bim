      },
      {
        "name": "mHajj",
        "lineageTag": "e2556704-7269-4f5e-bac9-bea70c986c2d",
        "partitions": [
          {
            "name": "mHajj",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),",
                "    #\"Tipo cambiado\" = Table.TransformColumnTypes(Origen,{{\"Columna1\", type text}}),",
                "    #\"Columnas quitadas\" = Table.RemoveColumns(#\"Tipo cambiado\",{\"Columna1\"})",
                "in",
                "    #\"Columnas quitadas\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "12. Mostrar Medida Ventas",
            "expression": [
              "",
              "var vAnio_evaluacion = SELECTEDVALUE(Alterno[Año])",
              "",
              "var vTotal = [20. Ventas por Periodo]",
              "var vMesActual = [27. Ventas Mes Actual]",
              "var vMesAnioAnterior = [29. Ventas Mes Año Anterior]",
              "",
              "var vMoM = [28. Dif. Ventas Mes Actual]",
              "var vMoM_P = [31. %Var Ventas MA]",
              "var vYoY = [30. Dif. Ventas SPLY]",
              "var vYoY_P = [32. %Var Ventas SPLY]",
              "",
              "var vYTDActual = [23. Ventas YTD]",
              "var vYTD_SPLY = [24. Ventas YTD SPLY]",
              "var vYTD_ = [25. Dif. Ventas YTD]",
              "",
              "var vYTD_P = [26. %Var Ventas YTD]",
              "",
              "RETURN IF(SELECTEDVALUE(Alterno[Indicador]) = 1,",
              "",
              "            IF(NOT(ISBLANK(vTotal)),",
              "                IF(ABS(vTotal)>1000000, FORMAT(vTotal, \"#,,.0M\",\"es-PE\"),",
              "                    IF(ABS(vTotal)>1000, FORMAT(vTotal,\"#,##0,.00K\",\"es-PE\"), FORMAT(vTotal, \"0\",\"es-PE\"))))",
              "            ,",
              "",
              "            SWITCH(vAnio_evaluacion,",
              "            ",
              "                \"Mes Actual\",",
              "                SWITCH(SELECTEDVALUE(Alterno[Mes Año]),[Mes Etiqueta Actual],",
              "                    IF(NOT(ISBLANK(vMesActual)), ",
              "                        IF(ABS(vMesActual)>1000000, FORMAT(vMesActual, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vMesActual)>1000, FORMAT(vMesActual,\"#,##0,.00K\",\"es-PE\"), FORMAT(vMesActual, \"0\",\"es-PE\")))),BLANK()),",
              "",
              "                \"Mes Anio Anterior\",",
              "                    SWITCH(SELECTEDVALUE(Alterno[Mes Año]),[Mes Etiqueta Actual (Y-1)], ",
              "                    IF(NOT(ISBLANK(vMesAnioAnterior)), ",
              "                        IF(ABS(vMesAnioAnterior)>1000000, FORMAT(vMesAnioAnterior, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vMesAnioAnterior)>1000, FORMAT(vMesAnioAnterior,\"#,##0,.00K\",\"es-PE\"), FORMAT(vMesAnioAnterior, \"0\",\"es-PE\")))),BLANK()),",
              "",
              "                \"MoM\",",
              "                    IF(NOT(ISBLANK(vMoM)),",
              "                        IF(ABS(vMoM)>1000000, FORMAT(vMoM, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vMoM)>1000, FORMAT(vMoM,\"#,##0,.00K\",\"es-PE\"), FORMAT(vMoM, \"0\",\"es-PE\")))),",
              "",
              "                \"MoM%\", IF(NOT(ISBLANK(vMoM_P)),FORMAT(vMoM_P, \"0.0%\",\"es-PE\")),",
              "",
              "                \"YoY\",",
              "                    IF(NOT(ISBLANK(vYoY)), ",
              "                        IF(ABS(vYoY)>1000000, FORMAT(vYoY, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vYoY)>1000, FORMAT(vYoY,\"#,##0,.00K\",\"es-PE\"), FORMAT(vYoY, \"0\",\"es-PE\")))),",
              "",
              "                \"YoY%\", IF(NOT(ISBLANK(vYoY_P)),FORMAT(vYoY_P, \"0.0%\",\"es-PE\")),",
              "",
              "                [Anio Pasado],",
              "                    IF(NOT(ISBLANK(vYTD_SPLY)), ",
              "                        IF(ABS(vYTD_SPLY)>1000000, FORMAT(vYTD_SPLY, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vYTD_SPLY)>1000, FORMAT(vYTD_SPLY,\"#,##0,.00K\",\"es-PE\"), FORMAT(vYTD_SPLY, \"0\",\"es-PE\")))),",
              "",
              "                [Anio Actual],",
              "                    IF(NOT(ISBLANK(vYTDActual)), ",
              "                        IF(ABS(vYTDActual)>1000000, FORMAT(vYTDActual, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vYTDActual)>1000, FORMAT(vYTDActual,\"#,##0,.00K\",\"es-PE\"), FORMAT(vYTDActual, \"0\",\"es-PE\")))),",
              "                ",
              "                \"YTD\", ",
              "                    IF(NOT(ISBLANK(vYTD_)), ",
              "                        IF(ABS(vYTD_)>1000000, FORMAT(vYTD_, \"#,,.0M\",\"es-PE\"),",
              "                            IF(ABS(vYTD_)>1000, FORMAT(vYTD_,\"#,##0,.00K\",\"es-PE\"), FORMAT(vYTD_, \"0\",\"es-PE\")))) ,",
              "                ",
              "                \"YTD%\", IF(NOT(ISBLANK(vYTD_P)),FORMAT(vYTD_P, \"0.0%\",\"es-PE\"))",
              "            ))"
            ],
            "lineageTag": "e62986c7-b593-4132-8c86-c3e293398a18"
          },
          {
            "name": "20. Ventas por Periodo",
            "expression": [
              "",
              "var vInicio = [22. Periodo Inicio]",
              "var vFin = [21. Periodo Fin]",
              "var vPeriodo = CONVERT(SELECTEDVALUE(Alterno[Periodo]), INTEGER)",
              "RETURN ",
              "IF(AND(vPeriodo >= vInicio, vPeriodo < vFin),",
              "            CALCULATE('Indicadores Port'[Port-Dinamico],",
              "                        'Dim Calendario'[Año Mes] = vPeriodo, REMOVEFILTERS('Dim Calendario')))"
            ],
            "lineageTag": "569c95da-d1b0-4240-adca-1f038921326d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "21. Periodo Fin",
            "expression": [
              "",
              "// Definición de la variable que obtiene la fecha máxima en la columna Fecha de la tabla Calendario",
              "VAR vFecha_maxima = MAX('Dim Calendario'[Date])",
              "",
              "// Definición de la variable que obtiene la fecha de fin de mes basada en la fecha máxima",
              "VAR vFin_mes = EOMONTH(vFecha_maxima, 0)",
              "",
              "// Definición de la variable que obtiene la fecha actual máxima en la tabla Calendario, ignorando filtros",
              "VAR vFecha_actual = MAXX(ALL('Dim Calendario'), 'Dim Calendario'[Date])",
              "",
              "// Retorno del valor formateado de Corte_Fin en el formato \"yyyyMM\" como un entero",
              "RETURN ",
              "CONVERT(FORMAT(vFin_mes, \"YYYYMM\"), INTEGER)"
            ],
            "formatString": "0",
            "lineageTag": "fb70be44-c0e4-4749-a583-7e92d94bd795"
          },
          {
            "name": "22. Periodo Inicio",
            "expression": [
              "",
              "// Definición de la variable que obtiene la fecha máxima en la columna Fecha de la tabla Calendario",
              "VAR vFecha_maxima = MAX('Dim Calendario'[date])",
              "",
              "// Definición de la variable Corte_Inicio que calcula el primer día del mes 13 meses atrás desde la fecha máxima",
              "VAR vCorte_Inicio = EOMONTH(vFecha_maxima, -13) + 1",
              "",
              "// Retorno del valor formateado de Corte_Inicio en el formato \"yyyyMM\" como un entero",
              "RETURN CONVERT(FORMAT(vCorte_Inicio, \"yyyyMM\"), INTEGER)"
            ],
            "formatString": "0",
            "lineageTag": "2b31e919-0937-4b2c-b6c6-dfe992741559"
          },
          {
            "name": "23. Ventas YTD",
            "expression": [
              "",
              "TOTALYTD('Indicadores Port'[Port-Dinamico], 'Dim Calendario'[Date])"
            ],
            "lineageTag": "24560a2f-a55a-4f2f-bec3-bbfff2aa4e73",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "24. Ventas YTD SPLY",
            "expression": [
              "",
              "TOTALYTD('Indicadores Port'[Port-Dinamico], SAMEPERIODLASTYEAR('Dim Calendario'[Date]))"
            ],
            "lineageTag": "b4660dd4-6cce-47ac-9b8a-3e7df7c6905b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "25. Dif. Ventas YTD",
            "expression": "[23. Ventas YTD]  - [24. Ventas YTD SPLY]",
            "formatString": "0",
            "lineageTag": "49d89713-644d-4690-9ff1-8c81f4d6d44b"
          },
          {
            "name": "26. %Var Ventas YTD",
            "expression": "DIVIDE([25. Dif. Ventas YTD], [24. Ventas YTD SPLY])",
            "lineageTag": "c54b1aaa-4085-4246-abf0-4f85d4a60135",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "27. Ventas Mes Actual",
            "expression": [
              "",
              " TOTALMTD('Indicadores Port'[Port-Dinamico], 'Dim Calendario'[Date])"
            ],
            "lineageTag": "b86caf0e-1a9b-40c9-ae75-eec1aa2e84a6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "28. Dif. Ventas Mes Actual",
            "expression": [
              "",
              "var vVentasSPLY = ",
              "CALCULATE('Indicadores Port'[Port-Dinamico], PREVIOUSMONTH('Dim Calendario'[Date]))",
              "RETURN ",
              "    [27. Ventas Mes Actual] - vVentasSPLY"
            ],
            "lineageTag": "a3465913-25dc-40f8-8aa1-be0c9023a73c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "29. Ventas Mes Año Anterior",
            "expression": "TOTALMTD('Indicadores Port'[Port-Dinamico], DATEADD('Dim Calendario'[Date],-1,YEAR))",
            "lineageTag": "3af4425c-e66e-4583-bba0-b01ef25a18b7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "30. Dif. Ventas SPLY",
            "expression": [
              "",
              "var vVentasSPLY = CALCULATE('Indicadores Port'[Port-Dinamico], SAMEPERIODLASTYEAR('Dim Calendario'[Date]))",
              "return [27. Ventas Mes Actual] - vVentasSPLY"
            ],
            "lineageTag": "24a84e05-d220-4bf4-9332-e98babfa7d4b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "31. %Var Ventas MA",
            "expression": [
              "",
              "var vVentasSPLY = CALCULATE('Indicadores Port'[Port-Dinamico], PREVIOUSMONTH('Dim Calendario'[Date]))",
              "RETURN DIVIDE([28. Dif. Ventas Mes Actual], vVentasSPLY,0) "
            ],
            "lineageTag": "cfaf85bd-4b5d-4636-9ca2-34e59d602f61",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "32. %Var Ventas SPLY",
            "expression": [
              "",
              "var vVentasSPLY = CALCULATE('Indicadores Port'[Port-Dinamico], SAMEPERIODLASTYEAR('Dim Calendario'[Date]))",
              "RETURN DIVIDE([30. Dif. Ventas SPLY], vVentasSPLY,0)"
            ],
            "lineageTag": "e4d1e918-cfa1-467f-adae-d1bb3eaac30a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Anio Actual",
            "expression": [
              "",
              "var vAnio = MAX('Dim Calendario'[Año])",
              "RETURN CONVERT(vAnio, STRING)"
            ],
            "lineageTag": "4d7f2e16-452a-4184-bf07-d0ef2559fbcc"
          },
          {
            "name": "Anio Pasado",
            "expression": [
              "",
              "var vAnio = MAX('Dim Calendario'[Año])",
              "RETURN CONVERT(vAnio - 1, STRING)"
            ],
            "lineageTag": "45eed526-b24e-4133-901f-c7bf15bc3122"
          },
          {
            "name": "Color",
            "expression": [
              "",
              "var periodo_max = CALCULATE(MAX('Fecha Anterior'[Mes Año]), DATESMTD('Fecha Anterior'[Fecha]))",
              "RETURN SWITCH(SELECTEDVALUE(Alterno[Año]),",
              "            periodo_max, \"#CFFDAF\",",
              "            \"Mes Actual\", \"#CFFDAF\",",
              "            \"MoM%\", \"#E2F0FB\",",
              "            \"YoY%\", \"#E2F0FB\",",
              "            \"YTD%\", \"#E2F0FB\"",
              "        )"
            ],
            "lineageTag": "305a0624-c7ef-41de-9ee3-b5d7815e7007"
          },
          {
            "name": "Mes Etiqueta Actual",
            "expression": [
              "",
              "var vFecha = EOMONTH(MAX('Dim Calendario'[Date]), -1) + 1",
              "var vMesNumero = MONTH(vFecha)",
              "var vAnio = YEAR(vFecha)",
              "var vMesCorto = ",
              "SWITCH(vMesNumero,",
              "        1,\"Ene\",",
              "        2,\"Feb\",",
              "        3,\"Mar\",",
              "        4,\"Abr\",",
              "        5,\"May\",",
              "        6,\"Jun\",",
              "        7,\"Jul\",",
              "        8,\"Ago\",",
              "        9,\"Sep\",",
              "        10,\"Oct\",",
              "        11,\"Nov\",",
              "        12,\"Dic\"",
              ")",
              "",
              "var vMesAnioAnterior = LEFT(vMesCorto,3)&\"-\"&vAnio",
              "",
              "RETURN vMesAnioAnterior"
            ],
            "lineageTag": "5886d1e6-d761-46c8-9b98-77d815c1f954"
          },
          {
            "name": "Mes Etiqueta Actual (Y-1)",
            "expression": [
              "",
