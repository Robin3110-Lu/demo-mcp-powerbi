        "partitions": [
          {
            "name": "Alterno",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "var vTabla = ADDCOLUMNS(SUMMARIZECOLUMNS('Fecha Anterior'[Periodo], 'Fecha Anterior'[Mes Año], 'Fecha Anterior'[Año]), \"Indicador\", 1)",
                "",
                "var vTabla2 = SUMMARIZECOLUMNS(Auxiliar[PeriodoNum],Auxiliar[Periodo],Auxiliar[Año],Auxiliar[Indicador])",
                "",
                "//Mes Actual",
                "var vTabla3 = ADDCOLUMNS(SUMMARIZECOLUMNS('Fecha Anterior'[Mes Año]),\"Mes Actual\",\"Mes Actual\", \"Indicador\", 2,\"Periodo\",\"000001\")",
                "",
                "//Mes Anio Anterior",
                "var vTabla4 = ADDCOLUMNS(SUMMARIZECOLUMNS('Fecha Anterior'[Mes Año]),\"Mes Anio Anterior\",\"Mes Anio Anterior\", \"Indicador\", 2,\"Periodo\",\"000000\")",
                "",
                "RETURN",
                "",
                "FILTER(UNION(vTabla,vTabla2,",
                "",
                "//Mes Actual",
                "SELECTCOLUMNS(vTabla3,\"Periodo\",[Periodo],\"Mes Año\",[Mes Año],\"Mes Actual\",[Mes Actual],\"Indicador\",[Indicador]),",
                "",
                "//Mes Anio Anterior",
                "SELECTCOLUMNS(vTabla4,\"Periodo\",[Periodo],\"Mes Año\",[Mes Año],\"Mes Anio Anterior\",[Mes Anio Anterior],\"Indicador\",[Indicador])",
                "",
                "), AND([Periodo] <> BLANK(),[Mes Año] <> BLANK()))",
                "",
                ""
              ]
            }
          }
        ],
