            ]
          },
          {
            "type": "calculated",
            "name": "TipoDato",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "SWITCH(TRUE(),'Indicadores Port'[Indicador]=\"Ratio Port-In/Port-Out\",\"Porcentaje\",\"Cantidad\") ",
            "lineageTag": "5a698167-63a9-4459-bf87-35b912a398cf",
