        "partitions": [
          {
            "name": "Vista",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45Wcs7PLchJLclX0lEyVIrViVZyzE3KLwbyjMC8gMSi5MzEHCDfWCk2FgA=\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Descripcion = _t, Orden = _t]),",
                "    #\"Tipo cambiado\" = Table.TransformColumnTypes(Origen,{{\"Descripcion\", type text}, {\"Orden\", Int64.Type}})",
                "in",
                "    #\"Tipo cambiado\""
              ]
            }
          }
        ],
        "annotations": [
