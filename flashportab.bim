              "var vFecha = EOMONTH(MAX('Dim Calendario'[Date]), -vPeriodos) + 1",
              "var vMesNumero = MONTH(vFecha)",
              "var vAnio = YEAR(vFecha)",
              "var vMesCorto = ",
              "SWITCH(vMesNumero,",
              "        1,\"Ene\",",
              "        2,\"Feb\",",
              "        3,\"Mar\",",
              "        4,\"Abr\",",
              "        5,\"May\",",
              "        6,\"Jun\",",
              "        7,\"Jul\",",
              "        8,\"Ago\",",
              "        9,\"Sep\",",
              "        10,\"Oct\",",
              "        11,\"Nov\",",
              "        12,\"Dic\"",
              ")",
