              "",
              "var vNoRealPostPago = CALCULATE([Port-Dinamico-No Real],'Dim Segmento'[FormaContratación]=\"Prepago\")+CALCULATE([Port-Dinamico Real],'Dim Segmento'[FormaContratación]=\"Postpago\")",
              "",
              "RETURN",
              " vNoRealPostPago ",
              ""
            ],
