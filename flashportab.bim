              }
            ]
          },
          {
            "name": "Total Departamentos Pierde",
            "expression": [
              "",
              "",
              "var vDepartamentosConPerdida =",
              "ADDCOLUMNS( VALUES('Dim Ubicacion'[Departamento]),",
              "                \"@Movistar\",CALCULATE([Port Neto Ubicacion],'Dim Operador'[Operador]=\"Movistar\"),",
              "                \"@Bitel\",CALCULATE([Port Neto Ubicacion],'Dim Operador'[Operador]=\"Bitel\"),",
              "                \"@Entel\",CALCULATE([Port Neto Ubicacion],'Dim Operador'[Operador]=\"Entel\"))",
              "",
              "RETURN",
              "            COUNTROWS(FILTER(vDepartamentosConPerdida,[@Movistar]<0 || [@Bitel]<0  || [@Entel]<0 ))",
              ""
            ],
            "formatString": "0",
            "lineageTag": "8f7f834c-e11b-44f7-b0cc-52d52a71fa31"
          },
          {
            "name": "Bitel Departamentos Pierde",
            "expression": [
              "",
              "",
              "COUNTROWS(FILTER(VALUES('Dim Ubicacion'[Departamento]),calculate([Port Neto Ubicacion],'Dim Operador'[Operador]=\"Bitel\")<0))"
            ],
            "formatString": "0",
            "lineageTag": "24d5ba55-0886-4581-8a00-3c9a0dace1d4"
          },
          {
            "name": "Entel Departamentos Pierde",
            "expression": [
              "",
              "",
              "COUNTROWS(FILTER(VALUES('Dim Ubicacion'[Departamento]),calculate([Port Neto Ubicacion],'Dim Operador'[Operador]=\"Entel\")<0))"
            ],
            "formatString": "0",
            "lineageTag": "ef70036e-f713-4b89-b881-349bff2e0134"
          },
          {
            "name": "Movistar Departamentos Pierde",
            "expression": [
              "",
              "",
              "COUNTROWS(FILTER(VALUES('Dim Ubicacion'[Departamento]),calculate([Port Neto Ubicacion],'Dim Operador'[Operador]=\"Movistar\")<0))"
            ],
            "formatString": "0",
            "lineageTag": "55b699f1-42b4-49dc-8c9d-f68b995cbbac"
          },
          {
            "name": "%Port Out Ubicacion",
            "expression": [
              "",
              "",
              "DIVIDE(",
              "        [Port Out Ubicacion],",
              "        CALCULATE([Port Out Ubicacion],",
              "        REMOVEFILTERS('Dim Operador'),REMOVEFILTERS('Dim Segmento'[FormaContratación]),REMOVEFILTERS('Dim Ubicacion'[Region])))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "5ec31f2e-78a5-444f-ac27-e7d47c50f306"
          },
          {
            "name": "%Port In Canal-Ubicacion",
            "expression": [
              "",
              "",
              "DIVIDE(",
              "        [Port In Canal-Ubicacion],",
              "        CALCULATE([Port In Canal-Ubicacion],",
              "        REMOVEFILTERS('Dim Operador'[Operador]),REMOVEFILTERS('Dim Segmento'[FormaContratación]),REMOVEFILTERS('Dim Ubicacion'[Region]),REMOVEFILTERS('Dim Canal'[MacroCanal]),REMOVEFILTERS('Dim Recarga'[RangoRecarga]),REMOVEFILTERS('Dim CF'[Rango]),REMOVEFILTERS('Dim Antiguedad'[RangoAntiguedad])))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "eea88b48-6f8f-4732-8111-0c04c69a834e"
          },
          {
            "name": "%PortDinamico",
            "expression": [
              "",
              "",
              "DIVIDE(",
              "        [Port-Dinamico],",
              "        CALCULATE([Port-Dinamico], REMOVEFILTERS('Dim Operador'),REMOVEFILTERS('Dim Segmento'),REMOVEFILTERS('Dim Ubicacion'),REMOVEFILTERS('Dim Canal'),REMOVEFILTERS('Dim Recarga'),REMOVEFILTERS('Dim CF'),REMOVEFILTERS('Dim Antiguedad')))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "6f0b8140-cc1b-476d-912d-eb15e1084412"
          }
        ],
