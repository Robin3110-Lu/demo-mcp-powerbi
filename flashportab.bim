              "",
              "var vNoRealPrepago =CALCULATE([Port-Dinamico-No Real],'Dim Segmento'[FormaContratación]=\"Postpago\")+CALCULATE([Port-Dinamico Real],'Dim Segmento'[FormaContratación]=\"Prepago\")",
